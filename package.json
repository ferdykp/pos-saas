{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.js\" \"resources/css/**/*.css\" \"tests/js/**/*.js\"",
        "format:check": "prettier --check \"resources/js/**/*.js\" \"resources/css/**/*.css\" \"tests/js/**/*.js\"",
        "test": "node --test tests/js/*.test.js"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.15.12",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "prettier": "3.6.2",
        "tailwindcss": "^3.1.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "aos": "^2.3.4",
        "axios": "^1.16.0"
    }
}
